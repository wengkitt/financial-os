# Drizzle Kit migrations / Studio: Neon's direct connection URL (pooling unchecked).
# Copy to .env and replace the example. Never prefix database credentials with VITE_.
DATABASE_URL="postgresql://ROLE:PASSWORD@ep-EXAMPLE.REGION.aws.neon.tech:5432/neondb?sslmode=require"

# Local Worker development: override the credential-free Wrangler local default.
# Use a development Neon branch. Hyperdrive pooling/caching is bypassed locally.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgresql://ROLE:PASSWORD@ep-EXAMPLE.REGION.aws.neon.tech:5432/neondb?sslmode=require"

# Authentication email delivery. Use the exact browser origin in local development.
APP_ORIGIN="http://localhost:5173"
RESEND_API_KEY=""
EMAIL_FROM="Financial OS <finance@YOUR-VERIFIED-DOMAIN.example>"
